"  var_sum=((var1+var2))\n","  return var_sum/2\n","def pr(formula):#So I don't have to write out the whole word every time... We programmers are kind of lazy I guess\n","  print(formula)\n","def pw(b,e):#Me being lazy again...\n","  return math.pow(b,e) \n","def _2(base_number):\n","  return (base_number*base_number)\n","def abs(var):#absolute value function\n","  var2=_2(var)\n","  return math.sqrt(var2)\n","\n","xt=1 #Original X value\n","vt=0 #Original velocity\n","at=-1 #Original acceleration\n","error1=0 #We start with no error\n","E1=.5 #Total energy\n","#@markdown Choose Which Equation:\n","equation=\"Euler\" #@param [\"Velocity-Verlet\", \"Euler\"]\n","#@markdown Time step/pi:\n","deltat=0.01#@param {type:\"number\"}\n","#@markdown How many time steps you want it to display\n","Length_Of_Run = 200#@param {type:\"number\"}\n","#@markdown k, or the Spring Stiffness Constant\n","k= 1 #@param {type:\"number\"} \n","#@markdown m, or the Mass of the Object attached to spring, in grams\n","m= 1#@param {type:\"number\"}\n","#@markdown Number of Animation frames shown per second in animation: *Note that the human eye will start to see motion somewhere between 30-60 fps\n","fps=60 #@param {type:\"number\"}  \n","intrvl=1000/fps#this takes desired fps and converts it to millisecond delay between frames\n","#@markdown How much delay before the animation repeats, in milliseconds\n","r_d=1000#@param {type:\"number\"}\n","#@markdown This changes how big the ball(which represents the object attached to spring) will be in the animation:   \n","ball_radius = 98 #@param {type:\"slider\", min:30, max:200, step:1}\n","#@markdown Color of ball shown in animation(r for red, g for green, b for blue)\n","ball_color= \"b\" #@param [\"r\",\"g\",\"b\"]\n","ballvar=ball_color+\"o\" #takes color and formats it into a marker style, by adding the o it makes a circle colored according to ball_color \n","#@markdown Number of animation frames to run\n","nframes=200 #@param {type:\"number\"}\n","x_t.append(xt) #Putting above values into respective arrays\n","v_t.append(vt)\n","a_t.append(at)\n","error.append(error1)\n","E.append(E1)\n","\n","\n","deltaT=deltat*pi\n","def  enmrte(times): #calculates and writes down the different formulas (Main function)\n","  t1=1 #Creating an index for each variable\n","  xt1=0\n","  vt1=0\n","  at1=0\n","  xte1=1\n","  er1=0\n","  e1=0\n","  time.append(0)\n","  x_t_exact.append(1)\n","  o=0#placeholder for equation output\n","  for i in range(times-1):\n","    if equation==\"Velocity-Verlet\":\n","      o=t1*deltaT #T\n","      time.append(o)\n","      t1+=1\n","      \n","      \n","      o=math.cos(xte1*deltaT)# x(t) exact\n","      x_t_exact.append(o)        \n","      xte1+=1\n","\n","      o=x_t[len(x_t)-1]+v_t[len(x_t)-1]*deltaT+.5*a_t[len(x_t)-1]*_2(deltaT) #x(t)\n","      x_t.append(o)\n","      xt1+=1\n","      \n","      o=(-1*k*x_t[len(x_t)-1])/m #a(t)\n","      a_t.append(o)\n","      at1+=1\n","\n","      o=v_t[len(v_t)-1]+.5*(a_t[len(a_t)-2]+a_t[len(a_t)-1])*deltaT #v(t)\n","      v_t.append(o)\n","      vt1+=1\n","      \n","      o=.5*m*_2(v_t[len(v_t)-1])+.5*k*_2(x_t[len(x_t)-1]) #Energy\n","      E.append(o)\n","      e1+=1\n","    \n","      o=abs(abs(x_t_exact[len(x_t_exact)-1])-abs(x_t[len(x_t)-1]))#error\n","      \n","      error.append(o)\n","      er1+=1\n","    if equation==\"Euler\":\n","      o=t1*deltaT #T\n","      time.append(o)\n","      t1+=1\n","      \n","      \n","      o=math.cos(xte1*deltaT)# x(t) exact\n","      x_t_exact.append(o)        \n","      xte1+=1\n","      \n","      o=x_t[len(x_t)-1]+v_t[len(x_t)-1]*deltaT+.5*a_t[len(x_t)-1]*_2(deltaT) #x(t)\n","      x_t.append(o)\n","      xt1+=1\n","      \n","      o=(-1*k*x_t[xt1])/m#a(t)\n","      a_t.append(o)\n","      at1+=1\n","      \n","      o=v_t[vt1]+a_t[at1-1]*deltaT#v(t)\n","      v_t.append(o)\n","      vt1+=1\n","\n","      o=.5*m*_2(v_t[len(v_t)-1])+.5*k*_2(x_t[len(x_t)-1]) #Energy\n","      E.append(o)\n","      e1+=1\n","\n","      o=abs(abs(x_t_exact[len(x_t_exact)-1])-abs(x_t[len(x_t)-1]))#error\n","      error.append(o)\n","      er1+=1\n","            \n","  pr(\"Delta T/Pi\")    #this section prints arrays and their titles\n","  pr(deltat)\n","  pr(\"T\")\n","  pr(time)\n","  pr(\"x(t)\")\n","  pr(x_t)\n","  pr(\"v(t)\")\n","  pr(v_t)\n","  pr(\"a(t)\")\n","  pr(a_t)\n","  pr(\"x(t) exact\")\n","  pr(x_t_exact)\n","  pr(\"error\")\n","  pr(error)\n","p=0\n","ax=plt.axes()\n","enmrte(Length_Of_Run)#executes main  function\n","def frame(w):#for x(t)\n","  \n","  global p\n","  global ball_radius\n","  global ball_color\n","  if not p>=w:\n","    \n","    if p==0:#first frame\n","      \n","      global x,y\n","      x=x_t[0]\n","      y=0 #I fixed y, as they y does not change\n","    elif p%2==0:#any subsequent even frame index\n","      x=x_t[p]\n","      y=0\n","    elif p%2==1:#any subsequent odd frame index\n","      x=x_t[p]\n","      y=0 \n","    \n","    ax.clear()    \n","    plt.title(\"x(t) Animation\")\n","    ax.set_xlabel(\"x(t)\")\n","    ax.set_xlim(-5.0,5.0)\n","    ax.set_ylim(-.5,.5)\n","    ax.scatter(x,y,s=ball_radius,c=ball_color)\n","    p+=1\n","anim = animation.FuncAnimation(fig, frame, frames=nframes, blit=False, repeat=True,repeat_delay=r_d,interval=intrvl)\n","anim"]},{"cell_type":"code","source":["#plots information\n","fig=plt.figure()\n","plt.subplot(331)\n","plt.title(\"Trajectory\")\n","plt.plot(time, x_t_exact)\n","plt.plot(time,x_t)\n","plt.xlabel(\"Time\")\n","plt.ylabel(\"position\")\n","plt.subplot(333)\n","plt.title(\"Error\")\n","plt.plot(time,error)\n","plt.xlabel(\"Time\")\n","plt.ylabel(\"Error\")\n","plt.subplot(335)\n","plt.title(\"Energy Conservation\")\n","plt.plot(time, E)\n","plt.xlabel(\"Time\")\n","plt.ylabel(\"Total Energy\")"],"metadata":{"id":"dFfBFbsqQFGx","executionInfo":{"status":"ok","timestamp":1686592209700,"user_tz":240,"elapsed":622,"user":{"displayName":"Ian Spurgeon","userId":"08418887955654596557"}},"colab"