{"cells":[{"cell_type":"code","execution_count":8,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000,"output_embedded_package_id":"1TE9AmdIeZgARJiMlWQXLSP8fa3tcSLTO"},"id":"wJzTqzU6gnqZ","executionInfo":{"status":"ok","timestamp":1690311628925,"user_tz":240,"elapsed":39921,"user":{"displayName":"Ian Spurgeon","userId":"08418887955654596557"}},"outputId":"517d6374-50db-4d3b-b555-776f25defece"},"outputs":[{"output_type":"display_data","data":{"text/plain":"Output hidden; open in https://colab.research.google.com to view."},"metadata":{}}],"source":["from mpl_toolkits.mplot3d.axes3d import axis3d\n","import math\n","import matplotlib.pyplot as plt\n","from matplotlib import rc\n","rc('animation',html='jshtml')\n","import numpy as np\n","from mpl_toolkits import mplot3d as plt3d\n","import matplotlib.animation as animation\n","\n","\n","\n","\n","pi=math.pi\n","time=[]\n","x_t=[]\n","v_t=[]\n","a_t=[]\n","x_t_exact=[]\n","error=[]\n","E=[]\n","def d(x,y):#returns derivative of a given point\n","  return y/x\n","def plotgraph(xarr,yarr,lx,ly):#     Takes two arrays and, using the first array's values as x coordinates\n","                              #     and the second one's for y coordinates, plots them, and then proceeding\n","  plt.plot(xarr,yarr)      #     to label the x axis as whatever 'lx' is and labels the y axis with the 'ly' argument\n","  plt.xlabel(lx)\n","  plt.ylabel(ly)\n","  return plt.plot\n","\n","\n","\n","def avg(var1, var2):\n","  var_sum=((var1+var2))\n","  return var_sum/2\n","def pr(formula):#So I don't have to write out the whole word every time... We programmers are kind of lazy I guess\n","  print(formula)\n","def pw(b,e):#Me being lazy again...\n","  return math.pow(b,e)\n","def _2(base_number):#returns input number squared\n","  return (base_number*base_number)\n","def abs(var):#absolute value function\n","  var2=_2(var)\n","  return math.sqrt(var2)\n","\n","\n","#@markdown Choose Which Equation:\n","equation=\"Velocity-Verlet\" #@param [\"Velocity-Verlet\", \"Euler\"]\n","#@markdown Time step (fs):\n","deltat=0.5#@param {type:\"number\"}\n","#@markdown How many time steps you want it to display\n","Length_Of_Run = 200#@param {type:\"number\"}\n","#@markdown The vibrational frequency in cm$^{-1}$\n","omega = 2000#@param {type:\"number\"}\n","#@markdown The reduced mass of the diatomic in a.m.u.\n","mu = 2#@param {type:\"number\"}\n","#@markdown Bond distance in angstroms\n","r=1.5 #@param {type:\"number\"}\n","#@markdown Number of Animation frames shown per second in animation: *Note that the human eye will start to see motion somewhere between 30-60 fps\n","fps=60 #@param {type:\"number\"}\n","intrvl=1000/fps#this takes desired fps and converts it to millisecond delay between frames\n","#@markdown How much delay before the animation repeats, in milliseconds\n","r_d=1000#@param {type:\"number\"}\n","#@markdown This changes how big objects shown in animation are, in typographic points(1 point=1/72 in)\n","object_radius = 100 #@param {type:\"slider\", min:30, max:200, step:1}\n","#@markdown Color of objects shown in animation(r for red, g for green, b for blue)\n","object_color= \"b\" #@param [\"r\",\"g\",\"b\"]\n","ballvar=object_color+\"o\" #takes color and formats it into a marker style, by adding the o it makes a circle colored according to object_color\n","#@markdown Number of animation frames to run *Note: number of frames can't be more than Length of run\n","nframes=200 #@param {type:\"number\"}\n","if nframes>Length_Of_Run:\n","  pr(\"Warning: number of animation frames cannot be larger than length of run. defaulting to length of run\")\n","  nframes=Length_Of_Run\n","\n","deltaT=deltat/0.002418843266 #Convert fs to atomic units\n","m=mu*1822.89 #convert amu to atomic units of mass (ie electron mass)\n","om=omega*7.2518152111*10**-7. #convert wavenumbers to atomic units of frequency\n","k=m*_2(om)\n","\n","\n","xt=1 #Original X value\n","vt=0 #Original velocity\n","at=-k/m #Original acceleration\n","error1=0 #We start with no error\n","E1=627.51*(0.5*k*_2(xt)+.5*m*_2(vt)) #Total energy\n","\n","x_t.append(xt) #Putting above values into respective arrays\n","v_t.append(vt)\n","a_t.append(at)\n","error.append(error1)\n","E.append(E1)\n","\n","def  enmrte(times): #calculates and writes down the different formulas (Main function)\n","  t1=1 #Creating an index for each variable\n","  xt1=0\n","  vt1=0\n","  at1=0\n","  xte1=1\n","  er1=0\n","  e1=0\n","  time.append(0)\n","  x_t_exact.append(1)\n","  o=0#placeholder for equation output\n","  for i in range(times-1):\n","    if equation==\"Velocity-Verlet\":\n","      o=t1*deltaT #T\n","      time.append(o)\n","      t1+=1\n","\n","\n","      o=math.cos(xte1*deltaT*om)# x(t) exact\n","      x_t_exact.append(o)\n","      xte1+=1\n","\n","      o=x_t[len(x_t)-1]+v_t[len(x_t)-1]*deltaT+.5*a_t[len(x_t)-1]*_2(deltaT) #x(t)\n","      x_t.append(o)\n","      xt1+=1\n","\n","      o=(-1*k*x_t[len(x_t)-1])/m #a(t)\n","      a_t.append(o)\n","      at1+=1\n","\n","      o=v_t[len(v_t)-1]+.5*(a_t[len(a_t)-2]+a_t[len(a_t)-1])*deltaT #v(t)\n","      v_t.append(o)\n","      vt1+=1\n","\n","      o=627.51*(.5*m*_2(v_t[len(v_t)-1])+.5*k*_2(x_t[len(x_t)-1])) #Energy\n","      E.append(o)\n","      e1+=1\n","\n","      o=abs(abs(x_t_exact[len(x_t_exact)-1])-abs(x_t[len(x_t)-1]))#error\n","\n","      error.append(o)\n","      er1+=1\n","    if equation==\"Euler\":\n","      o=t1*deltaT #T\n","      time.append(o)\n","      t1+=1\n","\n","\n","      o=math.cos(xte1*deltaT*om)# x(t) exact\n","      x_t_exact.append(o)\n","      xte1+=1\n","\n","      o=x_t[len(x_t)-1]+v_t[len(x_t)-1]*deltaT+.5*a_t[len(x_t)-1]*_2(deltaT) #x(t)\n","      x_t.append(o)\n","      xt1+=1\n","\n","      o=(-1*k*x_t[len(x_t)-1])/m #a(t)\n","      a_t.append(o)\n","      at1+=1\n","\n","      o=v_t[vt1]+a_t[at1-1]*deltaT#v(t)\n","      v_t.append(o)\n","      vt1+=1\n","\n","      o=627.51*(.5*m*_2(v_t[len(v_t)-1])+.5*k*_2(x_t[len(x_t)-1])) #Energy\n","      E.append(o)\n","      e1+=1\n","\n","      o=abs(abs(x_t_exact[len(x_t_exact)-1])-abs(x_t[len(x_t)-1]))#error\n","      error.append(o)\n","      er1+=1\n","\n","  pr(\"Delta T/Pi\")    #this section prints arrays and their titles\n","  pr(deltat)\n","  pr(\"T\")\n","  pr(time)\n","  pr(\"x(t)\")\n","  pr(x_t)\n","  pr(\"v(t)\")\n","  pr(v_t)\n","  pr(\"a(t)\")\n","  pr(a_t)\n","  pr(\"x(t) exact\")\n","  pr(x_t_exact)\n","  pr(\"error\")\n","  pr(error)\n","p=0\n","\n","enmrte(Length_Of_Run)#executes main  function\n","\n","\n","\n","fig=plt.figure()\n","ax=plt.axes(title=\"Animation\",xlabel=\"x(Angstroms)\",xlim=(-2,2),ylim=(-.5,.5))\n","#ax1= fig.add_axes(rect=(-1,0,1,.25)sharex=ax,sharey=ax)\n","def frame(w):#for x(t)\n","  global ax1\n","  global p\n","  global object_radius\n","  global object_color\n","  global r\n","  if not p>=w:\n","\n","    if p==0:#first frame\n","\n","      global x1,x2,y,d\n","      d=x_t[p]+r\n","      x1=0-.5*d\n","      x2=0+.5*d\n","      x=[x1,x2]\n","      y=[0,0] #I fixed y, as the y does not change\n","    elif p%2==0:#any subsequent even frame index\n","      d=x_t[p]+r\n","      x1=0-.5*d\n","      x2=0+.5*d\n","      x=[x1,x2]\n","      y=[0,0]\n","    elif p%2==1:#any subsequent odd frame index\n","      d=x_t[p]+r\n","      x1=0-.5*d\n","      x2=0+.5*d\n","      y=[0,0]\n","      x=[x1,x2]\n","    ax.clear()\n","    plt.title(\"Animation\")\n","    ax.set_xlim(-2.0,2.0)\n","    ax.set_ylim(-.5,.5)\n","    plt.xlabel(\"x(Angstroms)\")\n","    ax.scatter(x,y,s=object_radius,c=object_color)\n","    p+=1\n","\n","anim = animation.FuncAnimation(fig, frame, frames=nframes, blit=False, repeat=True,repeat_delay=r_d,interval=intrvl)\n","anim\n","\n"]},{"cell_type":"code","execution_count":7,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":397},"executionInfo":{"elapsed":1302,"status":"ok","timestamp":1690311290280,"user":{"displayName":"Ian Spurgeon","userId":"08418887955654596557"},"user_tz":240},"id":"dFfBFbsqQFGx","outputId":"3bc8b491-44fc-4e33-cb64-3bce13d74140"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 3 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["#plots information. For trajectory graph, x(t) exact is in blue, and x(t) in yellow\n","fig2= plt.figure(layout='constrained')\n","plt.subplot(331)\n","plt.title(\"Trajectory\")\n","plt.plot(time, x_t_exact)\n","plt.plot(time,x_t)\n","plt.xlabel(\"Time\")\n","plt.ylabel(\"position (bohr)\")\n","plt.subplot(333)\n","plt.title(\"Error\")\n","plt.plot(time,error)\n","plt.xlabel(\"Time (atomic units)\")\n","plt.ylabel(\"Error (bohr)\")\n","plt.subplot(335)\n","plt.title(\"Energy Conservation\")\n","plt.plot(time, E)\n","plt.xlabel(\"Time (atomic seconds)\")\n","plt.ylabel(\"Total Energy (kcal/mol)\")\n","plt.show()"]}],"metadata":{"colab":{"provenance":[{"file_id":"13BJ0MhNbBPNSXLBT5okHw-ECJcN4Zkf1","timestamp":1688155969974},{"file_id":"1W7uxm8Gb-Ym4015o9qnpTvN8UX-vbjae","timestamp":1687894369842},{"file_id":"1WVzbueBpSFcuCRV9uRs6n5CGjTSh1GOp","timestamp":1686598504414},{"file_id":"1p8rtnowkM-uACZiIvIdz_CUou38u9eG8","timestamp":1685645132807}]},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}