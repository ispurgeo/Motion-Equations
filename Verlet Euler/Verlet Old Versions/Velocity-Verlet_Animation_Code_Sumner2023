and writes down the different formulas (Main function)\n","  t1=1 #Creating an index for each variable\n","  xt1=0\n","  vt1=0\n","  at1=0\n","  xte1=1\n","  er1=0\n","  e1=0\n","  time.append(0)\n","  x_t_exact.append(1)\n","  o=0\n","  for i in range(times-1):\n","    o=t1*deltaT #T\n","    time.append(o)\n","    t1+=1\n","\n","\n","    o=math.cos(xte1*deltaT)#formula for x(t) exact\n","    x_t_exact.append(o)\n","    xte1+=1\n","\n","    o=x_t[len(x_t)-1]+v_t[len(x_t)-1]*deltaT+.5*a_t[len(x_t)-1]*_2(deltaT) #x(t)\n","    x_t.append(o)\n","    xt1+=1\n","\n","    o=(-1*k*x_t[len(x_t)-1])/m #a(t)\n","    a_t.append(o)\n","    at1+=1\n","\n","    o=v_t[len(v_t)-1]+.5*(a_t[len(a_t)-2]+a_t[len(a_t)-1])*deltaT #v(t)\n","    v_t.append(o)\n","    vt1+=1\n","\n","    o=.5*m*_2(v_t[len(v_t)-1])+.5*k*_2(x_t[len(x_t)-1]) #Energy\n","    E.append(o)\n","    e1+=1\n","\n","    o=abs(abs(x_t_exact[len(x_t_exact)-1])-abs(x_t[len(x_t)-1]))#error\n","\n","    error.append(o)\n","    er1+=1\n","\n","\n","\n","  pr(\"Delta T/Pi\")    #this section prints arrays and their titles\n","  pr(deltat)\n","  pr(\"T\")\n","  pr(time)\n","  pr(\"x(t)\")\n","  pr(x_t)\n","  pr(\"v(t)\")\n","  pr(v_t)\n","  pr(\"a(t)\")\n","  pr(a_t)\n","  pr(\"x(t) exact\")\n","  pr(x_t_exact)\n","  pr(\"error\")\n","  pr(error)\n","p=0\n","enmrte(Length_Of_Run)#executes main  function\n","def frame(w):#for x(t)\n","\n","  global p\n","  global ball_radius\n","  global ball_color\n","  if not p>w:\n","\n","    if p==0:#first frame\n","\n","      global x,y\n","      x=x_t[0]\n","      y=0\n","    elif p%2==0:#any subsequent even frame index\n","      x=x_t[p]\n","      y=0#+.5\n","    elif p%2==1:#any subsequent odd frame index\n","      x=x_t[p]\n","      y=0#-.5\n","    if p!=0:\n","      ax.clear()\n","    plt.title(\"Animation?\")\n","    ax.set_xlabel(\"x(t)\")\n","    ax.set_xlim(-5.0,5.0)\n","    ax.set_ylabel(\"y(NOT data-based)\")\n","    ax.set_ylim(-5.0,5.0)\n","    ax.scatter(x,y,s=ball_radius,c=ball_color)\n","    p+=1\n","\n","\n","\n","#fig1=plt.subplots(nrows=100,ncols=100)\n","#l=0\n","#for i in range(Length_of_Run):\n","#  fig1.add_subplot()\n","#  l+=1\n","anim = animation.FuncAnimation(fig, frame, frames=nframes, blit=False, repeat=True,interval=intrvl)\n","plt.axes(ax)\n","anim\n"]},{"cell_type":"code","source":["#plots information\n","fig=plt.figure()\n","plt.subplot(331)\n","plt.title(\"Trajectory\")\n","\n","\n","plt.plot(time, x_t_exact)\n","plt.plot(time,x_t)\n","plt.xlabel(\"Time\")\n","\n","plt.ylabel(\"position\")\n","plt.subplot(333)\n","plt.title(\"Error\")\n","plt.plot(time,error)\n","plt.xlabel(\"Time\")\n","plt.ylabel(\"Error\")\n","plt.subplot(335)\n","plt.title(\"Energy Conservation\")\n","plt.plot(time, E)\n","plt.xlabel(\"Time\")\n","plt.ylabel(\"Total Energy\")\n"],"metadata":{"id":"dFfBFbsqQFGx","executionInfo":{"status":"ok","timestamp":1756914004101,"user_tz":240,"elapsed":364,"user":{"displayName":"Ian Spurgeon","userId":"08418887955654596557"}},"colab":{"base_uri":"https://localhost:8080/","height":358},"outputId":"6e8e3ab9-2e1c-4d58-f7bb-f365dc17c4f9"},"execution_count":2,"outputs":[{"output_type":"execute_result","data":{"text/plain":["Text(0, 0.5, 'Total Energy')"]},"metadata":{},"execution_count":2},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 3 Axes>"],"image/png":"\n"},"metadata":{}}]}]}