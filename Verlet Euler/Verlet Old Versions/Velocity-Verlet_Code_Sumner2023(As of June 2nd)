","    xt1+=1\n","    \n","    o=(-1*k*x_t[len(x_t)-1])/m #a(t)\n","    a_t.append(o)\n","    at1+=1\n","\n","    o=v_t[len(v_t)-1]+.5*(a_t[len(a_t)-2]+a_t[len(a_t)-1])*deltaT #v(t)\n","    v_t.append(o)\n","    vt1+=1\n","    \n","    o=.5*m*_2(v_t[len(v_t)-1])+.5*k*_2(x_t[len(x_t)-1]) #Energy\n","    E.append(o)\n","    e1+=1\n","  \n","    o=abs(abs(x_t_exact[len(x_t_exact)-1])-abs(x_t[len(x_t)-1]))#error\n","    \n","    error.append(o)\n","    er1+=1\n","    \n","   \n","    \n","  pr(\"Delta T/Pi\")    #this section prints arrays and their titles\n","  pr(deltat)\n","  pr(\"T\")\n","  pr(time)\n","  pr(\"x(t)\")\n","  pr(x_t)\n","  pr(\"v(t)\")\n","  pr(v_t)\n","  pr(\"a(t)\")\n","  pr(a_t)\n","  pr(\"x(t) exact\")\n","  pr(x_t_exact)\n","  pr(\"error\")\n","  pr(error)\n","enmrte(200)#executes main  function\n","#plotgraph(time,error,\"Time\",\"Error\")\n","\n","plt.plot(time, x_t_exact)\n","plt.plot(time,x_t)\n","plt.xlabel(\"time\")\n","plt.ylabel(\"position\")"]}]}